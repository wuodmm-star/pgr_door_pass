<?xml version="1.0"?>
<!-- Powered wheelchair with ACTIVE FRONT STEERING (car-like), derived from the working buggy SDF structure
     (gazebo_ros_ackermann_drive needs SDF universal steer+roll front joints and sphere tyre collisions).
     Footprint about the rear (drive) axle: x in [-0.25, 0.80], y in [-0.33, 0.33]. The MODEL ORIGIN is the rear axle
     (the wheels sit at model x = 0 and 0.50); the chassis link is the body centre, 0.275 m ahead. The Ackermann plugin
     publishes odom -> rear_axle from the model pose; /ground_truth (p3d) is the chassis link (body centre).
     Wheelbase 0.50 m, front track 0.40, rear track 0.32,
     max steering 35 deg (0.6109 rad). Measured in Gazebo at full lock: R ~ 0.87-0.90 m (front tyre slip).
     PID gains scaled to the small wheel inertias (the buggy's 1500 / 1000 gains diverge to NaN on these wheels).
     /cmd_vel: linear.x = speed, angular.z = STEERING ANGLE (plugin convention). -->
<sdf version="1.6">
  <model name="wheelchair">
    <pose>0 0 0.05 0 0 0</pose>

    <!-- ============ 車体 (329kg のうち車体~285kg, 残りを4輪へ) ============ -->
    <link name="chassis">
      <pose>0.275 0 0.30 0 0 0</pose>
      <inertial>
        <mass>104.0</mass>
        <inertia>
          <ixx>9.0</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>12.0</iyy><iyz>0</iyz><izz>13.0</izz>
        </inertia>
      </inertial>
      <visual name="body">
        <geometry><box><size>1.05 0.66 0.25</size></box></geometry>
        <material>
          <ambient>0.85 0.45 0.1 1</ambient><diffuse>0.9 0.5 0.12 1</diffuse>
          <script><name>Gazebo/Orange</name><uri>file://media/materials/scripts/gazebo.material</uri></script>
        </material>
      </visual>
      <collision name="body">
        <geometry><box><size>1.05 0.66 0.25</size></box></geometry>
      </collision>
          <sensor name="lidar" type="ray">
        <!-- 0.17 above the chassis frame: on top of the body box (its top is at +0.125); inside it the rays hit the body -->
        <pose>0.425 0 0.17 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <ray>
          <scan><horizontal><samples>541</samples><resolution>1</resolution><min_angle>-2.3561945</min_angle><max_angle>2.3561945</max_angle></horizontal></scan>
          <range><min>0.05</min><max>8.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
        </ray>
        <plugin name="scan" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>laser</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- ============ ステアリングコラム(プラグインが要求, 車体内に隠して不可視) ============ -->
    <link name="steering_wheel">
      <pose>0.275 0 0.30 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.03</radius><length>0.03</length></cylinder></geometry>
      </visual>
    </link>
    <joint name="steering_joint" type="revolute">
      <parent>chassis</parent><child>steering_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-7.85</lower><upper>7.85</upper></limit>
        <dynamics><damping>1.0</damping></dynamics></axis>
    </joint>

    <!-- ============ タイヤ: 前輪universal(操舵+転動), 後輪revolute ============ -->
    <!-- 前左 -->
    <link name="front_left_wheel">
      <pose>0.50 0.20 0.10 0 0 0</pose>
      <inertial><mass>2</mass>
        <inertia><ixx>0.00500</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.01000</iyy><iyz>0</iyz><izz>0.00500</izz></inertia></inertial>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.1</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse>
          <script><name>Gazebo/Black</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material></visual>
      <collision name="collision">
        <geometry><sphere><radius>0.1</radius></sphere></geometry>
        <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          <contact><ode><min_depth>0.001</min_depth><kp>1e7</kp></ode></contact></surface></collision>
    </link>
    <joint name="front_left_combined_joint" type="universal">
      <parent>chassis</parent><child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.6109</lower><upper>0.6109</upper></limit></axis>
      <axis2><xyz>0 1 0</xyz></axis2>
    </joint>

    <!-- 前右 -->
    <link name="front_right_wheel">
      <pose>0.50 -0.20 0.10 0 0 0</pose>
      <inertial><mass>2</mass>
        <inertia><ixx>0.00500</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.01000</iyy><iyz>0</iyz><izz>0.00500</izz></inertia></inertial>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.1</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse>
          <script><name>Gazebo/Black</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material></visual>
      <collision name="collision">
        <geometry><sphere><radius>0.1</radius></sphere></geometry>
        <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          <contact><ode><min_depth>0.001</min_depth><kp>1e7</kp></ode></contact></surface></collision>
    </link>
    <joint name="front_right_combined_joint" type="universal">
      <parent>chassis</parent><child>front_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.6109</lower><upper>0.6109</upper></limit></axis>
      <axis2><xyz>0 1 0</xyz></axis2>
    </joint>

    <!-- 後左 -->
    <link name="rear_left_wheel">
      <pose>0.0 0.16 0.17 0 0 0</pose>
      <inertial><mass>3</mass>
        <inertia><ixx>0.02168</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.04335</iyy><iyz>0</iyz><izz>0.02168</izz></inertia></inertial>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.17</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse>
          <script><name>Gazebo/Black</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material></visual>
      <collision name="collision">
        <geometry><sphere><radius>0.17</radius></sphere></geometry>
        <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          <contact><ode><min_depth>0.001</min_depth><kp>1e7</kp></ode></contact></surface></collision>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- 後右 -->
    <link name="rear_right_wheel">
      <pose>0.0 -0.16 0.17 0 0 0</pose>
      <inertial><mass>3</mass>
        <inertia><ixx>0.02168</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.04335</iyy><iyz>0</iyz><izz>0.02168</izz></inertia></inertial>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.17</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse>
          <script><name>Gazebo/Black</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material></visual>
      <collision name="collision">
        <geometry><sphere><radius>0.17</radius></sphere></geometry>
        <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          <contact><ode><min_depth>0.001</min_depth><kp>1e7</kp></ode></contact></surface></collision>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ============ 関節角->/joint_states (RViz の rsp 用) ============ -->
    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>30</update_rate>
      <joint_name>front_left_combined_joint</joint_name>
      <joint_name>front_right_combined_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>

    <!-- ============ Ackermann 駆動プラグイン ============ -->
    <plugin name="ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>100.0</update_rate>

      <front_left_joint>front_left_combined_joint</front_left_joint>
      <front_right_joint>front_right_combined_joint</front_right_joint>
      <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
      <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
      <left_steering_joint>front_left_combined_joint</left_steering_joint>
      <right_steering_joint>front_right_combined_joint</right_steering_joint>
      <steering_wheel_joint>steering_joint</steering_wheel_joint>

      <max_steer>0.6109</max_steer>
      <max_steering_angle>7.85</max_steering_angle>
      <max_speed>1.0</max_speed>

      <left_steering_pid_gain>40 20 0.02</left_steering_pid_gain>
      <left_steering_i_range>-5 5</left_steering_i_range>
      <right_steering_pid_gain>40 20 0.02</right_steering_pid_gain>
      <right_steering_i_range>-5 5</right_steering_i_range>
      <linear_velocity_pid_gain>100 60 0.05</linear_velocity_pid_gain>
      <linear_velocity_i_range>-50 50</linear_velocity_i_range>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <publish_distance>false</publish_distance>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>rear_axle</robot_base_frame>
    </plugin>

    <plugin name="truth" filename="libgazebo_ros_p3d.so">
      <ros><remapping>odom:=ground_truth</remapping></ros>
      <body_name>chassis</body_name><frame_name>world</frame_name><update_rate>50</update_rate>
    </plugin>
  </model>
</sdf>
